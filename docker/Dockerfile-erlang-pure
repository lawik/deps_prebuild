ARG ELIXIR_VERSION
ARG OTP_VERSION
ARG BASE_IMAGE_OS="debian-bookworm-20260223"
ARG MIX_ENV

FROM hexpm/elixir:${ELIXIR_VERSION}-erlang-${OTP_VERSION}-${BASE_IMAGE_OS}

ARG MIX_ENV

# Pure BEAM packages don't need cross-compilation toolchains.
RUN apt-get update && apt-get install -y git

COPY . /build
WORKDIR /build

RUN mix local.hex --force && \
    mix local.rebar --force

ENV MIX_ENV=${MIX_ENV}

RUN msg=$(mix local.rebar --force) && \
    rebar_path=${msg#"* creating "} && \
    "$rebar_path" compile
